# Server-side settings for api/send-email.js.
#
# Copy to `.env` for local testing with `npx vercel dev` (`.env` is
# gitignored). In production these are set in the Vercel project under
# Settings -> Environment Variables — never committed.
#
# Nothing here is ever bundled into the browser: these are read by the
# serverless function only. That is the whole reason email moved server-side.

# The Gmail account that sends the mail, plus a 16-character App Password
# (Google Account -> Security -> App passwords; needs 2-Step Verification).
# NOT the normal account password — SMTP will reject that.
GMAIL_USER=vistaarcontent@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Supabase. The SERVICE ROLE key bypasses every RLS policy, so it belongs
# here and nowhere near the frontend — booking.config.js keeps the separate,
# public "publishable" key for the browser.
SUPABASE_URL=https://nnlogenvvhkvlvcvgpgs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
